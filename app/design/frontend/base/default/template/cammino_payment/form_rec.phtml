<?php $_code = $this->getMethodCode() ?>
<ul class="form-list" id="payment_form_<?php echo $_code ?>" style="display:none;">
    <li style="display: none;">
        <input type="hidden" id="<?php echo $_code ?>_ipag_card_token" name="payment[<?php echo $_code ?>_ipag_card_token]" value="" />
    </li>

    <!-- Número do cartão !-->
    <li>
        <label for="<?php echo $_code ?>_cc_number" class="required"><em>*</em><?php echo $this->__('Credit Card Number') ?></label>
        <div class="input-box">
            <input type="text" id="<?php echo $_code ?>_cc_number" title="<?php echo $this->__('Credit Card Number') ?>" name="payment[<?php echo $_code ?>_cc_number]" class="input-text pagarme-only-number required-entry validate-pagarme-cc-number" maxlength="19" value="" placeholder="•••• •••• •••• ••••" />
        </div>
    </li>

    <li>
        <strong><?php echo $this->getNumberOfRecurrences() ?> pagamentos de <?php echo Mage::helper('core')->currency($this->getRecurrenceAmount(), true, false) ?></strong>
    </li>


    <!-- Nome do dono do cartão !-->
    <li>
        <label for="<?php echo $_code ?>_cc_owner" class="required"><em>*</em><?php echo $this->__('Name on Card') ?></label>
        <div class="input-box">
            <input type="text" title="<?php echo $this->__('Name on Card') ?>" name="payment[<?php echo $_code ?>_cc_owner]" class="input-text required-entry" id="<?php echo $_code ?>_cc_owner" value="" />
        </div>
    </li>

    <!-- CPF do dono do cartão !-->
    <li id="<?php echo $_code ?>_cpf_div">
        <label for="<?php echo $_code ?>_cpf" class="required"><em>*</em>CPF</label>
        <div class="input-box">
            <input type="text" id="<?php echo $_code ?>_cpf" name="payment[<?php echo $_code ?>_cpf]" title="<?php echo $this->__('CPF') ?>" class="input-text required-entry validate-taxvat" value="" maxlength="14" placeholder="___.___.___-__" autocomplete="off" />
        </div>
    </li>


    <!-- Mês e ano !-->
    <li>
        <label for="<?php echo $_code ?>_expiration" class="required"><em>*</em><?php echo $this->__('Expiration Date') ?></label>
        <div class="input-box">
            <div class="v-fix pagarme-cc-expr-month">
                <select id="<?php echo $_code ?>_expiration" class="month validate-pagarme-cc-exp" name="payment[<?php echo $_code ?>_expiration]">
                    <?php foreach ($this->getCcMonths() as $k => $v) : ?>
                        <option value="<?php echo $k ? $v : '' ?>"><?php echo $v ?></option>
                    <?php endforeach ?>
                </select>
            </div>
            <div class="v-fix pagarme-cc-expr-year">
                <span>/</span>
                <select id="<?php echo $_code ?>_expiration_yr" class="year" name="payment[<?php echo $_code ?>_expiration_yr]">
                    <?php foreach ($this->getCcYears() as $k => $v) : ?>
                        <option value="<?php echo $k ? $k : '' ?>"><?php echo $v ?></option>
                    <?php endforeach ?>
                </select>
            </div>
        </div>
    </li>


    <!-- CVV !-->
    <li>
        <label for="<?php echo $_code ?>_cc_cid" class="required"><em>*</em><?php echo $this->__('Card Verification Number') ?></label>
        <div class="input-box">
            <div class="v-fix pagarme-cvv">
                <input type="text" title="<?php echo $this->__('Card Verification Number') ?>" class="input-text pagarme-only-number cvv required-entry validate-pagarme-cc-cvn" id="<?php echo $_code ?>_cc_cid" name="payment[<?php echo $_code ?>_cc_cid]" maxlength="4" value="" />
                <div class="pagarme-cvv-tool-tip">
                    <img src="<?php echo $this->getSkinUrl('pagarme/images/icon_cvv.gif') ?>" class="pagarme-cvv-icon" />
                    <div class="pagarme-cvv-image"><img src="<?php echo $this->getSkinUrl('pagarme/images/cvv.gif') ?>" alt="<?php echo $this->__('Card Verification Number Visual Reference') ?>" title="<?php echo $this->__('Card Verification Number Visual Reference') ?>" /></div>
                    <span class="pagarme-cvv-tool-tip-arrow">&nbsp;</span>
                </div>
            </div>
        </div>
    </li>

</ul>

<script>
    jQuery('#cammino_payment_rec_cc_owner').blur(function() {
        updateIpagRecToken();
    });
    jQuery('#cammino_payment_rec_cc_number').blur(function() {
        updateIpagRecToken();
    });
    jQuery('#cammino_payment_rec_expiration').blur(function() {
        updateIpagRecToken();
    });
    jQuery('#cammino_payment_rec_expiration_yr').blur(function() {
        updateIpagRecToken();
    });
    jQuery('#cammino_payment_rec_cc_cid').blur(function() {
        updateIpagRecToken();
    });
    jQuery('#cammino_payment_rec_cpf').blur(function() {
        updateIpagRecToken();
    });

    updateIpagRecToken = function() {
        if ('<?php echo Mage::getStoreConfig("payment/cammino_payment_ipag/active"); ?>' == '0') {
            return false;
        }
        var number = jQuery('#cammino_payment_rec_cc_number').val()
            ? jQuery('#cammino_payment_rec_cc_number').val().replace(/[^0-9]+/g, '') : null;
        var cvv = jQuery('#cammino_payment_rec_cc_cid').val()
            ? jQuery('#cammino_payment_rec_cc_cid').val() : null;
        var expMonth = jQuery('#cammino_payment_rec_expiration').val()
            ? jQuery('#cammino_payment_rec_expiration').val() : null;
        var expYear = jQuery('#cammino_payment_rec_expiration_yr').val()
            ? jQuery('#cammino_payment_rec_expiration_yr').val() : null;
        var holderName = jQuery('#cammino_payment_rec_cc_owner').val()
            ? jQuery('#cammino_payment_rec_cc_owner').val() : null;
        var cpfCnpj = jQuery('#cammino_payment_rec_cpf').val()
            ? jQuery('#cammino_payment_rec_cpf').val().replace(/[^0-9]+/g, '') : null;

        if (!number || !cvv || !expMonth || !expYear || !holderName) {
            return false;
        }

        jQuery.ajax({
            url: '<?php echo Mage::getUrl('camminopayment/token/ipag'); ?>',
            type: 'POST',
            data: {
                number: number,
                cvv: cvv,
                expiryMonth: expMonth,
                expiryYear: expYear,
                holderName: holderName,
                cpfCnpj: cpfCnpj
            },
            success: function(response) {
                var responseJson = (typeof response === 'string') ? JSON.parse(response) : response;
                if (responseJson && responseJson.token) {
                    jQuery('#cammino_payment_rec_ipag_card_token').val(responseJson.token);
                }
            }
        });
    }

    if (jQuery('#cammino_payment_rec_cpf')) {
        jQuery('#cammino_payment_rec_cpf').mask('000.000.000-00');
    }

    if (jQuery('#cammino_payment_rec_cc_number')) {
        jQuery('#cammino_payment_rec_cc_number').mask('0000 0000 0000 0000');
    }
</script>
